# Backend environment for running Django on the HOST (tests, runserver, seed).
#
# The defaults below match infra/docker-compose.yml, which publishes:
#   PostgreSQL -> localhost:5433  (user erp / password erp_dev_password)
#   Redis      -> localhost:6380
#
# If you run PostgreSQL/Redis natively instead of Docker, change the host,
# port and credentials here to match your installation.
# Never commit a real .env file.

SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://erp:erp_dev_password@localhost:5433/erp_dev
REDIS_URL=redis://localhost:6380/0
CACHE_URL=redis://localhost:6380/6

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTO_APPLY_ADVANCE=False

# Optional: run without PostgreSQL/Redis for a quick local demo.
# Uses SQLite + locmem cache + eager Celery. Never use in production.
USE_SQLITE=False

# Optional observability / operations
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# AUDIT_RETENTION_MONTHS=24
# TOTP_ISSUER=PharmaSuite
