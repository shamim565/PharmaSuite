[Unit]
Description=PharmaSuite API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=pharmasuite
Group=pharmasuite
WorkingDirectory=/srv/pharmasuite/backend
# Django reads backend/.env itself (django-environ), so no EnvironmentFile needed.
ExecStart=/srv/pharmasuite/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8011 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
