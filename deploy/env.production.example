# PharmaSuite — production environment (VPS)
# Copy to backend/.env on the server and fill in the real values.
# Generate a SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=False
SECRET_KEY=CHANGE_ME

# Hosts — bare hostnames, comma separated, NO scheme
ALLOWED_HOSTS=api-pharmasuite.ruletheday.app

# Postgres (native install on the VPS)
DATABASE_URL=postgres://pharmasuite:CHANGE_ME@127.0.0.1:5432/pharmasuite

# Redis — use DB indexes that don't collide with your other apps on this VPS.
# DB 6 is used for the Django cache; DB 5 is only needed if you later enable Celery.
CACHE_URL=redis://127.0.0.1:6379/6
REDIS_URL=redis://127.0.0.1:6379/5

# Browser origins — full scheme required here
CORS_ALLOWED_ORIGINS=https://pharmasuite.ruletheday.app
CSRF_TRUSTED_ORIGINS=https://api-pharmasuite.ruletheday.app

# Branding / security
TOTP_ISSUER=PharmaSuite

# Optional: error tracking (pip dependency is already installed)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional tuning
# THROTTLE_LOGIN_RATE=20/min
# AUDIT_RETENTION_MONTHS=24
# SECURE_HSTS_SECONDS=31536000
