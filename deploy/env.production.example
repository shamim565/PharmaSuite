# PharmaSuite — production environment (VPS Docker stack)
# Copy to the REPO ROOT as .env on the server:
#   cp deploy/env.production.example /opt/pharmasuite/.env && chmod 600 /opt/pharmasuite/.env

DEBUG=False
SECRET_KEY=CHANGE_ME   # openssl rand -base64 48

# Bare hostnames, comma separated, NO scheme.
# localhost/127.0.0.1 are required: the container healthcheck calls them.
ALLOWED_HOSTS=api-pharmasuite.ruletheday.app,localhost,127.0.0.1

# PostgreSQL runs on the HOST (same server as ruletheday-backend, own
# database). Create the role + database once — see docs/deployment-vps.md §2.
# `host.docker.internal` is the host machine, as seen from inside the
# container. Use a URL-safe password (openssl rand -hex 24): @ : / would
# break the URL parsing.
DATABASE_URL=postgres://pharmasuite:CHANGE_ME_STRONG@host.docker.internal:5432/pharmasuite

# Redis runs in the compose stack (service name "redis")
CACHE_URL=redis://redis:6379/6
REDIS_URL=redis://redis:6379/5

# Browser origins — full scheme required here
CORS_ALLOWED_ORIGINS=https://pharmasuite.ruletheday.app
CSRF_TRUSTED_ORIGINS=https://api-pharmasuite.ruletheday.app

# The outer ruletheday nginx terminates TLS and redirects http->https at the
# edge, so Django does not need to force SSL itself. Keeping it off also makes
# the container healthcheck / loopback curls real 200s instead of 301s.
SECURE_SSL_REDIRECT=False

# Branding / security
TOTP_ISSUER=PharmaSuite

# Optional: error tracking (dependency already installed)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional tuning
# THROTTLE_LOGIN_RATE=20/min
# AUDIT_RETENTION_MONTHS=24
